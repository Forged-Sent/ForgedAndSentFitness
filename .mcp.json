{
  "mcpServers": {
    "dart": {
      "command": "cmd",
      "args": [
        "/c",
        "dart",
        "mcp-server"
      ]
    },
    "playwright": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@0.0.83",
        "--browser=chrome"
      ]
    },
    "maestro": {
      "command": "cmd",
      "args": [
        "/c",
        "maestro",
        "mcp"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly"
    }
  }
}
