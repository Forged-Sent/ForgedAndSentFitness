{
  "inputs": [
    {
      "id": "forgedGoogleKnowledgeApiKey",
      "type": "promptString",
      "description": "Personal Google Developer Knowledge API key (from your own Google Cloud project). Never share or commit it.",
      "password": true
    }
  ],
  "servers": {
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server"
      ]
    },
    "firebase": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "firebase-tools@latest",
        "mcp"
      ]
    },
    "playwright": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--browser=chrome"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/readonly"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "maestro": {
      "type": "stdio",
      "command": "maestro",
      "args": [
        "mcp"
      ]
    },
    "google-developer-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${input:forgedGoogleKnowledgeApiKey}"
      }
    }
  }
}
