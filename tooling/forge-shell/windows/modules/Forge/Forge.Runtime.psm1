function Get-ForgeCatalog {
    if (-not $script:Catalog) { $script:Catalog=@([IO.File]::ReadAllText((Join-Path $script:PackageRoot 'config\catalog.json')) | ConvertFrom-Json) }
    return $script:Catalog
