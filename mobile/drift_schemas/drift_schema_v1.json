      "name": "completion_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"completion_events\" (\"id\" TEXT NOT NULL, \"owner_id\" TEXT NOT NULL, \"day\" TEXT NOT NULL, \"item\" TEXT NOT NULL, \"done\" INTEGER NOT NULL CHECK (\"done\" IN (0, 1)), \"counter\" INTEGER NOT NULL UNIQUE, \"tapped_at_utc_ms\" INTEGER NOT NULL, \"utc_offset_minutes\" INTEGER NOT NULL, \"replaces_event_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
