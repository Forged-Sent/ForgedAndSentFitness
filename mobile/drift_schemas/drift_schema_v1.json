          "sql": "CREATE TABLE IF NOT EXISTS \"day_states\" (\"owner_id\" TEXT NOT NULL, \"day\" TEXT NOT NULL, \"item\" TEXT NOT NULL, \"done\" INTEGER NOT NULL CHECK (\"done\" IN (0, 1)), \"latest_event_id\" TEXT NOT NULL, \"latest_counter\" INTEGER NOT NULL, PRIMARY KEY (\"owner_id\", \"day\", \"item\"));"
