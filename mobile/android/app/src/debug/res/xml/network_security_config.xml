<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only (ADR-0002): overrides the same-named resource in
     src/main/res/xml/. Allows cleartext HTTP solely to the Android Emulator's
     alias for the development machine, where the local Firebase emulators
     listen. Every other host stays blocked. Main, profile and release builds
     use src/main/res/xml/network_security_config.xml (no exceptions). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
