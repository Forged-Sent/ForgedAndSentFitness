# Generated Flutter/Dart caches and build artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
# IDE local state
.idea/
*.iml
# Local Firebase credentials
firebase_options.local.dart

# Android and iOS hosts (android/, ios/) are committed. Their own template
# .gitignore files keep local.properties, Gradle/Pods caches, ephemeral and
# generated plugin registrants out of version control.
# Web and desktop hosts stay temporary; setup and CI generate web locally (ADR-0003).
/web/
/macos/
/windows/
/linux/
# `flutter create` rewrites .metadata whenever setup or CI adds another
# platform, so tracking it would leave clean clones dirty.
/.metadata
