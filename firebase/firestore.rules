rules_version = '2';
// Forged & Sent: Firestore security rules (DRAFT, Phase 0).
// Contract: docs/architecture/02-data-architecture-firestore.md. Protected zone (ADR-0015).
// Verified by firebase/tests/rules/*.test.mjs (run in CI with the emulator).
// Principles: deny by default; group path is the isolation boundary; privileged collections are Functions-only
// (Admin SDK bypasses rules); facts are create-only; journals are owner-only.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }
    function memberPath(gid) { return /databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid); }
    function membership(gid) { return get(memberPath(gid)).data; }
    function isMember(gid) {
      return signedIn() && exists(memberPath(gid)) && membership(gid).state == 'active';
    }
    function hasRole(gid, roles) { return isMember(gid) && membership(gid).role in roles; }
    function isLeader(gid) { return hasRole(gid, ['leader', 'owner']); }
    function isReviewer(gid) { return hasRole(gid, ['reviewer', 'leader', 'owner']); }
    function onlyKeys(keys) { return request.resource.data.keys().hasOnly(keys); }
    function unchanged(keys) { return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys); }
    function changedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isDate(s) { return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }

    // ---------- deny by default ----------
    match /{document=**} { allow read, write: if false; }

    // ---------- personal (owner-only) ----------
    match /users/{uid} {
      allow read: if isUser(uid);
      allow create: if isUser(uid)
        && onlyKeys(['tz', 'locale', 'createdAt', 'adultAttestedAt'])
        && request.resource.data.tz is string
        && request.resource.data.adultAttestedAt == request.time;
      allow update: if isUser(uid) && changedOnly(['tz', 'locale']);

      match /settings/{key} { allow read, write: if isUser(uid); }
      // Reflections, personal prayers, confessions: owner only, forever (FS-PRV-001).
      match /journal/{entryId} { allow read, write: if isUser(uid); }
      match /days/{localDate} { allow read, write: if isUser(uid) && isDate(localDate); }
      match /sessions/{sessionId} {
        allow read: if isUser(uid);
        allow create: if isUser(uid) && request.resource.data.revision == 1;
        // Revision-guarded single-writer updates (FS-OFF-007).
        allow update: if isUser(uid) && request.resource.data.revision == resource.data.revision + 1;
        allow delete: if false;
      }
      match /foodEntries/{entryId} { allow read, write: if isUser(uid); }
      match /nutritionDays/{localDate} { allow read, write: if isUser(uid) && isDate(localDate); }
      match /fasting/{doc} { allow read, write: if isUser(uid); }
      match /healthSources/{type} { allow read, write: if isUser(uid); }
      match /healthDays/{id} { allow read, write: if isUser(uid); }
      match /bodyMetrics/{id} { allow read, write: if isUser(uid); }
      match /progressPhotos/{id} { allow read, write: if isUser(uid); }
      match /shares/{id} { allow read, write: if isUser(uid); }
      match /prs/{id} { allow read: if isUser(uid); allow write: if false; }      // Functions only
      match /exports/{id} { allow read: if isUser(uid); allow write: if false; }  // Functions only
    }

    // ---------- groups ----------
    match /groups/{gid} {
      allow read: if isMember(gid);
      allow write: if false; // Functions only

      match /members/{memberUid} {
        allow read: if isMember(gid);
        allow write: if false; // Functions only (FS-ACC-002)
      }
      match /invites/{inviteId} {
        allow read: if isLeader(gid);
        allow write: if false; // createInvite / redeemInvite callables
      }
      match /partnerships/{pairId} {
        allow read: if isMember(gid) && request.auth.uid in resource.data.uids;
        allow create: if isMember(gid)
          && request.auth.uid in request.resource.data.uids
          && request.resource.data.uids.size() == 2
          && request.resource.data.acceptedBy == [request.auth.uid];
        allow update, delete: if false; // acceptance via Function
      }

      // Facts: create-only, own uid in deterministic id, server timestamp (FS-CMP-002).
      match /checkins/{checkinId} {
        allow read: if isMember(gid) && resource.data.uid == request.auth.uid;
        allow create: if isMember(gid)
          && request.resource.data.uid == request.auth.uid
          && checkinId == request.auth.uid + '_' + request.resource.data.habitId + '_' + request.resource.data.localDate
          && isDate(request.resource.data.localDate)
          && request.resource.data.receivedAt == request.time
          && onlyKeys(['uid', 'habitId', 'localDate', 'tz', 'source', 'performedAt', 'receivedAt', 'payloadHash']);
        allow update, delete: if false;
      }
      match /activity/{activityId} {
        allow read: if isMember(gid);
        allow write: if false;
      }

      match /posts/{postId} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.body is string && request.resource.data.body.size() <= 2000
          && (!('media' in request.resource.data) || request.resource.data.media.size() <= 4)
          && !('removedAt' in request.resource.data);
        allow update: if isMember(gid) && resource.data.authorUid == request.auth.uid
          && changedOnly(['body', 'editedAt']) && request.resource.data.editedAt == request.time;
        allow delete: if isMember(gid) && resource.data.authorUid == request.auth.uid;
        match /comments/{cid} {
          allow read: if isMember(gid);
          allow create: if isMember(gid) && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.body is string && request.resource.data.body.size() <= 1000;
          allow update: if isMember(gid) && resource.data.authorUid == request.auth.uid && changedOnly(['body', 'editedAt']);
          allow delete: if isMember(gid) && resource.data.authorUid == request.auth.uid;
        }
        match /reactions/{reactorUid} {
          allow read: if isMember(gid);
          allow create, update: if isMember(gid) && reactorUid == request.auth.uid
            && request.resource.data.kind in ['strong', 'brother'];
          allow delete: if isMember(gid) && reactorUid == request.auth.uid;
        }
      }

      // Prayer requests: audience-scoped (FS-PRV-002). Queries must constrain audience/audienceUids.
      match /prayerRequests/{rid} {
        function canSeePrayer(d) {
          return isMember(gid) && (
            d.authorUid == request.auth.uid
            || d.audience == 'group'
            || (d.audience == 'leaders' && isLeader(gid))
            || (d.audience == 'partners' && request.auth.uid in d.audienceUids));
        }
        allow read: if canSeePrayer(resource.data);
        allow create: if isMember(gid)
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.audience in ['private', 'partners', 'leaders', 'group']
          && request.resource.data.audienceUids is list && request.resource.data.audienceUids.size() <= 20;
        allow update: if isMember(gid) && resource.data.authorUid == request.auth.uid && unchanged(['authorUid']);
        allow delete: if isMember(gid) && resource.data.authorUid == request.auth.uid;
        match /updates/{id} {
          allow read: if canSeePrayer(get(/databases/$(database)/documents/groups/$(gid)/prayerRequests/$(rid)).data);
          allow write: if isMember(gid) && get(/databases/$(database)/documents/groups/$(gid)/prayerRequests/$(rid)).data.authorUid == request.auth.uid;
        }
        match /prayed/{prayerUid} {
          allow read: if isMember(gid) && (prayerUid == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(gid)/prayerRequests/$(rid)).data.authorUid == request.auth.uid);
          allow write: if prayerUid == request.auth.uid
            && canSeePrayer(get(/databases/$(database)/documents/groups/$(gid)/prayerRequests/$(rid)).data);
        }
      }

      match /reports/{reportId} {
        allow read: if isLeader(gid) || (isMember(gid) && resource.data.reporterUid == request.auth.uid);
        allow create: if isMember(gid) && request.resource.data.reporterUid == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /moderationActions/{id} { allow read: if isLeader(gid); allow write: if false; }

      // ---------- competition ----------
      match /seasons/{sid} {
        allow read: if isMember(gid);
        allow write: if false;
        match /teams/{tid} { allow read: if isMember(gid); allow write: if false; }
        match /enrollments/{euid} { allow read: if isMember(gid); allow write: if false; }
        match /missions/{mid} {
          allow read: if isMember(gid);
          allow write: if false;
          match /completions/{cuid} {
            allow read: if isMember(gid) && cuid == request.auth.uid;
            allow create: if isMember(gid) && cuid == request.auth.uid
              && request.resource.data.receivedAt == request.time
              && onlyKeys(['variantId', 'performedAt', 'receivedAt', 'note', 'payloadHash']);
            allow update, delete: if false;
          }
        }
        match /challenges/{cid} {
          function challenge() { return get(/databases/$(database)/documents/groups/$(gid)/seasons/$(sid)/challenges/$(cid)).data; }
          allow read: if isMember(gid);
          allow write: if false;
          match /attempts/{attemptId} {
            allow read: if isMember(gid) && (resource.data.uid == request.auth.uid || isReviewer(gid));
            // Window enforced with server time (FS-CMP-008); grace in minutes from the challenge config.
            allow create: if isMember(gid)
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.status == 'submitted'
              && request.resource.data.receivedAt == request.time
              && request.time >= challenge().opensAt
              && request.time <= challenge().closesAt + duration.value(challenge().graceMinutes, 'm')
              && request.resource.data.tier in ['standard', 'foundation']
              && (!('proofIds' in request.resource.data) || request.resource.data.proofIds.size() <= 3);
            // Owner may only attach proof while still submitted; everything else is Functions-only.
            allow update: if isMember(gid) && resource.data.uid == request.auth.uid
              && resource.data.status == 'submitted' && changedOnly(['proofIds'])
              && request.resource.data.proofIds.size() <= 3;
            allow delete: if false;
            match /reviews/{rid} { allow read: if isMember(gid) && (isReviewer(gid) || get(/databases/$(database)/documents/groups/$(gid)/seasons/$(sid)/challenges/$(cid)/attempts/$(attemptId)).data.uid == request.auth.uid); allow write: if false; }
          }
        }
        // Functions-only scoring collections (FS-CMP-001).
        match /ledger/{entryId} {
          allow read: if isMember(gid) && (resource.data.uid == request.auth.uid || isLeader(gid));
          allow write: if false;
        }
        match /standings/{id} { allow read: if isMember(gid); allow write: if false; }
        match /snapshots/{id} { allow read: if isMember(gid); allow write: if false; }
        match /appeals/{aid} {
          allow read: if isMember(gid) && (resource.data.uid == request.auth.uid || isLeader(gid));
          allow create: if isMember(gid) && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'open';
          allow update, delete: if false;
        }
      }
    }

    // Collection-group query for "my attempts" across challenges.
    match /{path=**}/attempts/{attemptId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- global, admin-published ----------
    match /rulesets/{rid} { allow read: if signedIn(); allow write: if false; }
    match /content/{pkg}/versions/{ver} { allow read: if signedIn(); allow write: if false; }
    match /organizations/{oid} { allow read, write: if false; } // future; grants no member data (FS-ACC-005)
    match /auditLog/{id} { allow read, write: if false; }        // Functions + console only

    // ---------- reserved, inactive (ADR-0013, ADR-0017) ----------
    match /households/{doc=**} { allow read, write: if false; }
    match /guardianLinks/{doc=**} { allow read, write: if false; }
    match /conversations/{doc=**} { allow read, write: if false; }
  }
}
