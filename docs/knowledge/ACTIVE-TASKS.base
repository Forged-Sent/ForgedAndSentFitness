filters:
  and:
    - or:
        - file.inFolder("knowledge/handoffs")
        - file.inFolder("docs/knowledge/handoffs")
    - file.ext == "md"
    - file.name != "TEMPLATE"
    - note.status == "active"
properties:
  file.name:
    displayName: Task
  note.owner:
    displayName: Owner
  note.stage:
    displayName: Progress
  note.next_action:
    displayName: Next action
  note.updated:
    displayName: Last updated
  note.coordinator_model:
    displayName: Coordinator
  note.profile:
    displayName: Task profile
views:
  - type: table
    name: Active handoffs (not WORK rows)
    order:
      - file.name
      - note.stage
      - note.owner
      - note.coordinator_model
      - note.profile
      - note.next_action
      - note.updated
  - type: kanban
    name: Handoff stages (Obsidian 1.14+)
    groupBy:
      property: note.stage
      direction: ASC
    order:
      - file.name
      - note.owner
      - note.next_action
