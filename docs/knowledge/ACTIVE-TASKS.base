filters:
  and:
    - file.inFolder("knowledge/handoffs")
    - file.ext == "md"
    - file.name != "TEMPLATE"
    - status == "active"
properties:
  file.name:
    displayName: Task
  owner:
    displayName: Owner
  stage:
    displayName: Progress
  next_action:
    displayName: Next action
  updated:
    displayName: Last updated
  coordinator_model:
    displayName: Coordinator
  profile:
    displayName: Task profile
views:
  - type: table
    name: Active tasks
    order:
      - file.name
      - stage
      - owner
      - coordinator_model
      - profile
      - next_action
      - updated
  - type: kanban
    name: Progress board (Obsidian 1.14+)
    groupBy:
      property: stage
      direction: ASC
    order:
      - file.name
      - owner
      - next_action
